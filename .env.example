# ==============================================================================
# Pounamu Atelier — Environment Variables
# ==============================================================================
# Copy this file to `.env` for local development, or configure these variables
# in your hosting provider / AI Studio Secrets panel.
# Never commit real secret keys (`sk_live_...`, `whsec_...`, passwords) to git.

# --- 1. Server & Public Origin ---
# Port the Express + Vite server listens on (AI Studio requires 3000)
PORT="3000"
# Fallback port if PORT is unset or matches NGINX_PORT
DEFAULT_APP_PORT="3000"
# Public base URL used for SEO canonical tags, sitemap.xml, and transactional email links
APP_URL="http://localhost:3000"
# Optional explicit override for sitemap.xml base URL (defaults to Admin canonicalUrl -> APP_URL)
SITE_URL=""
# Set to "production" when running compiled output (`npm run build && npm run start`)
NODE_ENV="development"
# Disables Vite HMR file watching in hosted iframe previews
DISABLE_HMR="true"

# --- 2. Initial Admin Bootstrap (Optional — used only when `users` table is empty) ---
# When starting with a fresh empty SQLite database, set these so an initial ADMIN user is created.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_FIRST_NAME="Studio"
ADMIN_LAST_NAME="Admin"

# --- 3. Stripe Payments (Required for card checkout, or configure in Admin > Payment Settings) ---
# Database values saved via Admin Dashboard override these environment fallbacks.
STRIPE_PUBLISHABLE_KEY=""
VITE_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- 4. Transactional Order & Gift Card Emails (Optional) ---
# If neither RESEND_API_KEY nor SMTP_HOST is set, emails are recorded in the Admin Outbox (`order_emails` table).
EMAIL_FROM="Pounamu Atelier <orders@pounamuatelier.co.nz>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# --- 5. Google Sign-In OAuth (Optional — or configure in Admin Dashboard > Storefront Settings) ---
VITE_GOOGLE_CLIENT_ID=""

# --- 6. SEO Sitemap Scheduler ---
# Minutes between automatic background regenerations of `public/sitemap.xml`
SITEMAP_INTERVAL_MINUTES="15"

# --- 7. Optional AI Studio Runtime Secret (Reserved) ---
GEMINI_API_KEY=""
